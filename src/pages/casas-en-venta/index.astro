---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Layout/Navbar';

const title = "Casas en Venta en Tlajomulco | Bosques California";
const description = "Descubre la mejor oferta de casas en venta en Tlajomulco y el sur de Guadalajara. Plusvalía, seguridad y amenidades premium.";

const zones = [
    { slug: 'santa-anita', name: 'Santa Anita' },
    { slug: 'san-agustin', name: 'San Agustín' },
    { slug: 'tlajomulco', name: 'Tlajomulco' },
    { slug: 'sur-guadalajara', name: 'Sur de Guadalajara' }
];
---

<Layout title={title} description={description}>
    <Navbar client:load currentPage="home" onNavigate={() => {}} />

    <main class="pt-32 px-6 max-w-7xl mx-auto min-h-screen">
        <div class="text-center mb-16">
            <h1 class="font-serif text-5xl md:text-6xl text-forest mb-6">Casas en Venta en el Sur de GDL</h1>
            <p class="max-w-3xl mx-auto text-gray-600 text-lg">
                La zona sur de Guadalajara se ha consolidado como el polo de desarrollo residencial más importante 
                de la última década. Bosques California te ofrece la mejor ubicación dentro de este corredor de plusvalía.
            </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            {zones.map(zone => (
                <a href={`/casas-en-venta/${zone.slug}`} class="bg-white p-8 rounded-xl shadow-lg border border-gray-100 hover:border-gold hover:shadow-xl transition-all text-center group">
                    <h3 class="font-serif text-2xl text-forest group-hover:text-gold mb-2">{zone.name}</h3>
                    <span class="text-sm text-gray-400 uppercase tracking-widest">Ver Disponibilidad</span>
                </a>
            ))}
        </div>
    </main>
</Layout>

