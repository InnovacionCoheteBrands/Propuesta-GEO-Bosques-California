---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Layout/Navbar';
// We assume ReferralPage is exported from Forms.tsx. If not we need to check.
// Checking previous file view: 'import { ContactPage, ReferralPage } from ...' in App.tsx.
// So it is exported.
import { ReferralPage as ReferralFormComponent } from '../components/Pages/Forms';

const title = "Refiere y Gana | Bosques California";
const description = "Gana recompensas refiriendo a tus conocidos. Programa de referidos de Bosques California.";
---

<Layout title={title} description={description}>
    <!-- Navbar handles navigation state -->
    <Navbar client:load currentPage="refiere" onNavigate={() => {}} /> 
    
    <!-- We wrap the React component in a main div for spacing if needed, or let it handle its own layout -->
    <main class="min-h-screen">
        <ReferralFormComponent client:load />
    </main>
</Layout>

