---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Layout/Navbar';
import ModelsComponent from '../../components/Pages/Models';

const title = "Modelos de Casas | Bosques California";
const description = "Conoce nuestros modelos de casas exclusivas: Ciprés, Roble B y Secuoya. Residencias con diseño californiano contemporáneo y espacios optimizados en Tlajomulco.";
---

<Layout title={title} description={description}>
    <Navbar client:load currentPage="modelos" onNavigate={() => {}} />

    <main class="min-h-screen">
        <ModelsComponent client:only="react" />
    </main>
</Layout>

