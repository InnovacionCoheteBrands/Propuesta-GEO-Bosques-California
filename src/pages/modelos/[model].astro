---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Layout/Navbar';
import { HOUSE_MODELS } from '../../constants';
import Schema from '../../components/SEO/Schema.astro';
// import ModelDetail from '../../components/Pages/ModelDetail'; // We might need to create this or use existing Models component adapted

export function getStaticPaths() {
  return HOUSE_MODELS.map(model => ({
    params: { model: model.id },
    props: { model },
  }));
}

const { model } = Astro.props;

// Calculate metadata
const title = `Modelo ${model.name} | Bosques California`;
const description = `Conoce el modelo ${model.name}, una residencia de ${model.specs[0].value} con ${model.specs[1].value} recámaras en Bosques California.`;

const productData = {
  "name": `Modelo ${model.name} - Bosques California`,
  "description": model.description,
  "image": `https://bosquescalifornia.com${model.image}`,
  "numberOfRooms": model.specs.find(s => s.label === 'Recámaras')?.value || "3",
  "occupancy": {
    "@type": "Occupancy",
    "numberOfBathroomsTotal": model.specs.find(s => s.label === 'Baños')?.value || "2.5"
  },
  "floorSize": {
    "@type": "QuantitativeValue",
    "value": model.specs.find(s => s.label === 'Construcción' || s.label === 'Total')?.value.replace(' m²', ''),
    "unitCode": "MTK"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Tlajomulco de Zúñiga",
    "addressRegion": "Jalisco",
    "addressCountry": "MX"
  }
};
---

<Schema type="SingleFamilyResidence" data={productData} />

<Layout title={title} description={description}>
    <Navbar client:load currentPage="modelos" onNavigate={() => {}} /> 
    
    <main class="pt-24 px-4 md:px-20 max-w-7xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center min-h-[80vh]">
            <div>
                 <span class="text-gold tracking-widest text-sm font-bold uppercase mb-2 block">Modelo Exclusivo</span>
                 <h1 class="font-serif text-5xl md:text-7xl text-forest mb-6">{model.name}</h1>
                 <p class="text-gray-600 text-lg leading-relaxed mb-8">{model.description}</p>
                 
                  <div class="grid grid-cols-2 gap-6 mb-12">
                     {model.specs.map(spec => (
                         <div class="border-l-2 border-gold pl-4">
                             <span class="block text-xs uppercase tracking-widest text-gray-400">{spec.label}</span>
                             <span class="block text-xl font-serif text-forest">{spec.value}</span>
                         </div>
                     ))}
                  </div>

                  {model.features && (
                      <div class="grid grid-cols-2 gap-12 mb-12 py-8 border-y border-gray-100">
                          <div>
                              <h4 class="text-xs font-bold text-forest uppercase tracking-widest mb-4">Planta Baja</h4>
                              <ul class="space-y-2">
                                  {model.features.pb.map(feature => (
                                      <li class="flex items-center gap-3 text-sm text-gray-500">
                                          <div class="w-1.5 h-1.5 rounded-full bg-gold shrink-0"></div>
                                          {feature}
                                      </li>
                                  ))}
                              </ul>
                          </div>
                          <div>
                              <h4 class="text-xs font-bold text-forest uppercase tracking-widest mb-4">Planta Alta</h4>
                              <ul class="space-y-2">
                                  {model.features.pa.map(feature => (
                                      <li class="flex items-center gap-3 text-sm text-gray-500">
                                          <div class="w-1.5 h-1.5 rounded-full bg-gold shrink-0"></div>
                                          {feature}
                                      </li>
                                  ))}
                              </ul>
                          </div>
                      </div>
                  )}

                 <a href="/contacto" class="bg-forest text-white px-8 py-4 rounded-full uppercase tracking-widest text-xs font-bold hover:bg-gold transition-colors inline-block">
                    Agendar Visita
                 </a>
            </div>
            <div class="relative aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl">
                <img src={model.image} alt={`Modelo ${model.name}`} class="w-full h-full object-cover" />
            </div>
        </div>
    </main>
</Layout>
