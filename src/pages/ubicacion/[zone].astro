---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Layout/Navbar';

export function getStaticPaths() {
    const zones = [
        { 
            slug: 'galerias-santa-anita', 
            title: 'Galerías Santa Anita',
            tagline: 'El centro del estilo de vida en el sur',
            desc: 'Un espacio donde la arquitectura moderna se funde con la naturaleza. Galerías Santa Anita no es solo un centro comercial, es el punto de encuentro predilecto para quienes buscan marcas exclusivas, gastronomía de autor y entretenimiento de primer nivel.',
            features: ['Liverpool & Marcas Premium', 'Cinemex Platino', 'Restaurantes con Terraza', 'Jardines Interiores'],
            image: '/images/location-galerias.png'
        },
        { 
            slug: 'lopez-mateos-sur', 
            title: 'López Mateos Sur',
            tagline: 'Conectividad que transforma tu día',
            desc: 'La arteria principal que da vida al sur de la ciudad. Vivir cerca de López Mateos Sur garantiza un acceso rápido a las principales zonas financieras y corporativas de Guadalajara, manteniendo la privacidad de un entorno residencial.',
            features: ['Acceso a Periférico', 'Carriles Centrales Fluidos', 'Nueva Infraestructura Vial', 'Servicios 24/7'],
            image: '/images/location-lopez.png'
        },
        { 
            slug: 'punto-sur', 
            title: 'Punto Sur',
            tagline: 'Donde la ciudad cobra vida',
            desc: 'Un concepto lifestyle center que redefine la experiencia urbana. Punto Sur combina residencias, oficinas y comercio en un entorno vibrante y cosmopolita, ideal para disfrutar de las tardes y fines de semana.',
            features: ['Mercado Gastronómico', 'Eventos Culturales', 'Hotel Aloft', 'Shopping al Aire Libre'],
            image: '/images/location-puntosur.png'
        }
    ];
    return zones.map(zone => ({
        params: { zone: zone.slug },
        props: { zone }
    }));
}

const { zone } = Astro.props;
const title = `${zone.title} | Bosques California Ubicación`;
const description = `Descubre ${zone.title}, un punto clave cerca de Bosques California.`;
---

<Layout title={title} description={description}>
    <div class="bg-off-white min-h-screen font-sans">
        <Navbar 
            client:load 
            currentPage="ubicacion" 
            onNavigate={(page) => {
                const path = page === 'home' ? '/' : `/${page}`;
                window.location.href = path;
            }} 
        />

        <!-- Parallax Hero -->
        <div class="relative h-[60vh] overflow-hidden">
            <img 
                src={zone.image} 
                alt={zone.title} 
                class="absolute inset-0 w-full h-full object-cover"
                style="view-transition-name: hero-image;" 
            />
            <div class="absolute inset-0 bg-forest/60 backdrop-blur-[2px]"></div>
            
            <div class="absolute inset-0 flex flex-col justify-center items-center text-center p-6 text-white pt-24">
                <span class="text-gold tracking-[0.3em] text-xs font-bold uppercase mb-4 animate-fade-in-up">Ubicación Premium</span>
                <h1 class="font-serif text-5xl md:text-7xl mb-6 animate-fade-in-up delay-100">{zone.title}</h1>
                <p class="text-xl font-light max-w-2xl opacity-90 animate-fade-in-up delay-200">{zone.tagline}</p>
            </div>
            
            <a href="/ubicacion" class="absolute top-28 left-6 z-20 text-white/70 hover:text-white flex items-center gap-2 transition-colors">
                <span class="text-lg">&larr;</span> Volver al mapa
            </a>
        </div>

        <!-- Content -->
        <main class="max-w-4xl mx-auto px-6 py-20 bg-white -mt-20 relative rounded-t-3xl shadow-xl z-10">
            <div class="grid md:grid-cols-12 gap-12">
                <div class="md:col-span-8">
                    <h2 class="font-serif text-3xl text-forest mb-6">Sobre la Zona</h2>
                    <p class="text-gray-600 leading-loose text-lg font-light mb-8">
                        {zone.desc}
                    </p>
                    
                    <h3 class="font-serif text-xl text-forest mb-4 border-b border-gray-100 pb-2">Destacados</h3>
                    <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {zone.features.map(feature => (
                            <li class="flex items-center gap-3 text-gray-600">
                                <span class="w-2 h-2 rounded-full bg-gold/50"></span>
                                {feature}
                            </li>
                        ))}
                    </ul>
                </div>
                
                <div class="md:col-span-4 space-y-6">
                    <div class="bg-off-white p-6 rounded-2xl border border-gray-100">
                        <span class="block text-xs uppercase tracking-widest text-gray-400 mb-2">Distancia</span>
                        <div class="flex items-baseline gap-1">
                            <span class="text-4xl font-serif text-forest">5-10</span>
                            <span class="text-sm text-gray-500">minutos</span>
                        </div>
                        <p class="text-xs text-gray-400 mt-2">Tiempo estimado en auto desde Bosques California.</p>
                    </div>

                    <a href="/contacto" class="block w-full text-center py-4 bg-forest text-white text-sm font-medium tracking-widest uppercase hover:bg-gold transition-colors duration-300 rounded-xl">
                        Agendar Recorrido
                    </a>
                </div>
            </div>
        </main>
        
    </div>
</Layout>

<style>
    /* Simple animation utilities if Tailwind config doesn't have them */
    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }
    .delay-100 { animation-delay: 0.1s; }
    .delay-200 { animation-delay: 0.2s; }

    @keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
