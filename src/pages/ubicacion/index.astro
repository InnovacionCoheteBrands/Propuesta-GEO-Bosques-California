---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Layout/Navbar';

const title = "Ubicación Privilegiada | Bosques California";
const description = "Bosques California: Conectividad estratégica en el sur de Guadalajara. Cerca de Punto Sur, Galerías Santa Anita y las mejores zonas residenciales.";

const zones = [
    {
        slug: 'galerias-santa-anita',
        title: 'Galerías Santa Anita',
        desc: 'Lifestyle & Shopping Exclusivo',
        distance: '3 Minutos',
        image: '/images/location-galerias.png' 
    },
    {
        slug: 'lopez-mateos-sur',
        title: 'López Mateos Sur',
        desc: 'Conectividad Directa',
        distance: 'Acceso Inmediato',
        image: '/images/location-lopez.png'
    },
    {
        slug: 'punto-sur',
        title: 'Punto Sur',
        desc: 'Gastronomía & Vida Nocturna',
        distance: '8 Minutos',
        image: '/images/location-puntosur.png'
    }
];

const pointsOfInterest = [
    { category: 'Educación', items: ['Prepa Tec de Monterrey', 'Instituto Tepeyac', 'Colegio Pedregal'] },
    { category: 'Salud', items: ['Hospital Puerta de Hierro Sur', 'Hospital de Especialidades'] },
    { category: 'Shopping', items: ['Plaza Galerías Santa Anita', 'Punto Sur', 'Plaza La Rioja'] }
];
---

<Layout title={title} description={description}>
    <div class="bg-off-white min-h-screen font-sans selection:bg-gold/30">
        <Navbar 
            client:load 
            currentPage="ubicacion" 
            onNavigate={(page) => {
                const path = page === 'home' ? '/' : `/${page}`;
                window.location.href = path;
            }} 
        />

        <!-- Hero Section -->
        <section class="relative pt-32 pb-20 px-6 overflow-hidden">
            <div class="max-w-7xl mx-auto text-center relative z-10">
                <span class="inline-block py-1 px-3 rounded-full border border-navy/20 text-navy text-xs tracking-[0.2em] uppercase mb-6 bg-white/50 backdrop-blur-sm">Conectividad Total</span>
                <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl text-navy mb-8 leading-tight">
                    El Corazón <br/>
                    <span class="italic text-gold">del Sur</span>
                </h1>
                <p class="max-w-2xl mx-auto text-gray-500 text-lg md:text-xl font-light leading-relaxed">
                    Una ubicación estratégica en <strong>López Mateos Sur, Tlajomulco</strong>, que combina la tranquilidad de un entorno natural 
                    con la cercanía inmediata a los centros de vida urbana más vibrantes de la ciudad.
                </p>
            </div>
            
            <!-- Deco Elements -->
            <div class="absolute top-1/4 left-0 w-64 h-64 bg-sage/10 rounded-full blur-3xl -z-10"></div>
            <div class="absolute bottom-0 right-0 w-96 h-96 bg-gold/5 rounded-full blur-3xl -z-10"></div>
        </section>

        <!-- Connectivity & Map Section -->
        <section class="px-6 pb-24">
            <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 items-start">
                
                <!-- Left: Points of Interest -->
                <div class="lg:col-span-4 space-y-12 pt-8">
                    <div>
                        <h2 class="font-serif text-3xl text-navy mb-6">Puntos de Interés</h2>
                        <p class="text-gray-500 font-light mb-8">
                            Todo lo que necesitas para una vida plena se encuentra a solo unos minutos de tu hogar.
                        </p>
                    </div>

                    <div class="space-y-8">
                        {pointsOfInterest.map((category) => (
                            <div class="group">
                                <h3 class="text-lg font-medium text-navy border-b border-navy/10 pb-2 mb-4 flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
                                    {category.category}
                                </h3>
                                <ul class="space-y-3">
                                    {category.items.map(item => (
                                        <li class="text-gray-500 text-sm pl-4 relative before:absolute before:left-0 before:top-1/2 before:-translate-y-1/2 before:w-1 before:h-px before:bg-gray-300">
                                            {item}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))}
                    </div>
                    
                    <div class="bg-navy text-white p-8 rounded-2xl relative overflow-hidden group hover:shadow-xl transition-all duration-500">
                         <div class="absolute top-0 right-0 w-32 h-32 bg-gold/20 rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl"></div>
                         <h3 class="font-serif text-2xl mb-2 relative z-10">Agenda tu Visita</h3>
                         <p class="text-white/70 text-sm mb-6 relative z-10 font-light">Ven a conocer tu nuevo entorno y enamórate de la zona.</p>
                         <button class="w-full py-3 bg-white text-navy font-medium text-sm tracking-widest uppercase hover:bg-gold hover:text-white transition-colors duration-300 relative z-10">
                             Contactar Asesor
                         </button>
                    </div>
                </div>

                <!-- Right: Map Visualization -->
                <div class="lg:col-span-8">
                    <div class="relative bg-white p-4 rounded-3xl shadow-2xl shadow-navy/5">
                        <div class="aspect-[16/9] w-full bg-gray-100 rounded-2xl overflow-hidden relative shadow-inner group">
                             <!-- Real Google Maps Iframe -->
                             <iframe 
                                src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d3735.8376042007794!2d-103.4733178!3d20.5538244!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x842f55001599fbc1%3A0x367efb52a27b6197!2sBosques%20california!5e0!3m2!1ses-419!2sus!4v1768429023051!5m2!1ses-419!2sus"
                                class="w-full h-full grayscale-[0.2] contrast-[1.1] opacity-90 group-hover:grayscale-0 group-hover:opacity-100 group-hover:contrast-100 transition-all duration-700"
                                style="border:0;" 
                                allowfullscreen="" 
                                loading="lazy" 
                                referrerpolicy="no-referrer-when-downgrade">
                            </iframe>
                        </div>
                        
                        <div class="mt-6 grid grid-cols-3 gap-4 text-center">
                            <div class="p-4 rounded-xl bg-off-white/50 border border-transparent hover:border-navy/10 transition-colors">
                                <span class="block text-2xl font-serif text-gold mb-1">5 min</span>
                                <span class="text-xs text-gray-500 uppercase tracking-wider">A Plaza Galerías</span>
                            </div>
                            <div class="p-4 rounded-xl bg-off-white/50 border border-transparent hover:border-navy/10 transition-colors">
                                <span class="block text-2xl font-serif text-gold mb-1">15 min</span>
                                <span class="text-xs text-gray-500 uppercase tracking-wider">López Mateos Sur</span>
                            </div>
                            <div class="p-4 rounded-xl bg-off-white/50 border border-transparent hover:border-navy/10 transition-colors">
                                <span class="block text-2xl font-serif text-gold mb-1">10 min</span>
                                <span class="text-xs text-gray-500 uppercase tracking-wider">Hospitales</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Zones Overview -->
        <section class="py-24 bg-white">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="font-serif text-4xl text-navy mb-4">Zonas Cercanas</h2>
                    <p class="text-gray-500 font-light max-w-2xl mx-auto">Lugares emblemáticos que elevan tu calidad de vida.</p>
                </div>

                <div class="grid md:grid-cols-3 gap-8">
                    {zones.map(zone => (
                        <a href={`/ubicacion/${zone.slug}`} class="group relative aspect-[3/4] overflow-hidden rounded-2xl cursor-pointer">
                            <img 
                                src={zone.image} 
                                alt={zone.title} 
                                class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/20 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
                            
                            <div class="absolute bottom-0 left-0 p-8 w-full transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                <p class="text-gold text-xs font-bold tracking-widest uppercase mb-2">{zone.distance}</p>
                                <h3 class="text-white font-serif text-3xl mb-2">{zone.title}</h3>
                                <p class="text-white/80 text-sm font-light opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">
                                    {zone.desc}
                                </p>
                                <div class="mt-4 inline-flex items-center text-white/90 text-xs border-b border-white/30 pb-1 group-hover:border-white transition-colors">
                                    Explorar Zona &rarr;
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    </div>
</Layout>
